# 이 파일을 복사해서 .env.local 로 만들고 값을 채워주세요.
# cp env.sample .env.local   (윈도우: copy env.sample .env.local)
# 값을 채운 뒤에는 앱(dev 서버)을 껐다 다시 켜야 반영됩니다.

# Cloudflare Workers AI — AI 이미지 생성을 쓸 때만 필요합니다. 안 채워도 앱은 정상 동작합니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# claude CLI 경로를 자동으로 못 찾을 때만 지정하세요 (보통 비워둬도 됩니다)
CLAUDE_BIN=
